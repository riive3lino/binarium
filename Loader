-- ========== JOGOS SUPORTADOS ==========
-- cada jogo devolve TODAS as bolas (cada bola nova que nasce conta)
local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") and inst.PrimaryPart then return inst.PrimaryPart end
    return inst:FindFirstChildWhichIsA("BasePart", true)
end

local vefCache, vefScan = {}, 0

local GAMES = {
    {
        name = "TCs",
        getAll = function()
            local list = {}
            for _, c in ipairs(workspace:GetChildren()) do
                if c.Name == "TPS" then
                    local p = partOf(c)
                    if p then table.insert(list, p) end
                end
            end
            return list
        end,
    },
    {
        name = "VEF",
        getAll = function()
            local list, seen = {}, {}

            local pitch = workspace:FindFirstChild("Pitch")
            local balls = pitch and pitch:FindFirstChild("Balls")
            if balls then
                for _, c in ipairs(balls:GetChildren()) do
                    local p = partOf(c)
                    if p and not seen[p] then
                        seen[p] = true
                        table.insert(list, p)
                    end
                end
            end

            -- bolas fora do caminho esperado: procura partes chamadas VEF (a cada 2s)
            if tick() - vefScan > 2 then
                vefScan = tick()
                vefCache = {}
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d.Name == "VEF" and d:IsA("BasePart") then
                        table.insert(vefCache, d)
                    end
                end
            end
            for _, d in ipairs(vefCache) do
                if d.Parent and not seen[d] then
                    seen[d] = true
                    table.insert(list, d)
                end
            end

            return list
        end,
    },
}

local ballList, ballGame, lastScan = {}, nil, 0

local function getBalls()
    if tick() - lastScan > 0.15 then
        lastScan = tick()
        ballList, ballGame = {}, nil
        for _, g in ipairs(GAMES) do
            local list = g.getAll()
            if #list > 0 then
                ballList, ballGame = list, g.name
                break
            end
        end
    end
    return ballList, ballGame
end

