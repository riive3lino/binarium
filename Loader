-- ========== NoCD ==========
local noCD = false
local savedCD = {}
local hasGC = typeof(getgc) == "function"
local hasTouch = typeof(firetouchinterest) == "function"

local function applyCD(on)
    if not hasGC then return end
    for _, t in ipairs(getgc(true)) do
        if type(t) == "table" then
            local ok, v = pcall(rawget, t, "Cooldown")
            if ok and type(v) == "number" then
                if on then
                    if v > 0 then
                        savedCD[t] = v
                        pcall(rawset, t, "Cooldown", 0)
                    end
                elseif savedCD[t] then
                    pcall(rawset, t, "Cooldown", savedCD[t])
                end
            end
        end
    end
    if not on then savedCD = {} end
end

task.spawn(function()
    while gui.Parent do
        if noCD then applyCD(true) end
        task.wait(2)
