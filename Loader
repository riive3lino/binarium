local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
end

-- um "ponteiro" ativo: so o toque/clique que comecou no elemento conta
local function isSamePointer(active, i, ending)
    if active.UserInputType == Enum.UserInputType.Touch then
        return i == active
    end
    if ending then
        return i.UserInputType == Enum.UserInputType.MouseButton1
    end
    return i.UserInputType == Enum.UserInputType.MouseMovement
end

-- arrastar
local function makeDraggable(target, handle, onTap, onMoved)
    local active, startInput, startPos, moved = nil, nil, nil, false

    handle.InputBegan:Connect(function(i)
        if active or not isPress(i) then return end
        active = i
        startInput = i.Position
        startPos = target.Position
        moved = false
    end)

    table.insert(conns, UserInputService.InputChanged:Connect(function(i)
        if not active or not isSamePointer(active, i, false) then return end
        local d = i.Position - startInput
        if d.Magnitude > 6 then moved = true end
        if moved then
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end))

    table.insert(conns, UserInputService.InputEnded:Connect(function(i)
        if not active or not isSamePointer(active, i, true) then return end
        active = nil
        if moved then
            if onMoved then onMoved() end
        elseif onTap then
            onTap()
        end
    end))
end

local function posToTable(p)
    return { p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset }
end

local function tableToPos(t)
    return UDim2.new(t[1], t[2], t[3], t[4])
end

-- botao que repete enquanto segura
local function holdButton(btn, fn)
    local token, active = 0, nil

    btn.InputBegan:Connect(function(i)
        if not isPress(i) then return end
        active = i
        token = token + 1
        local my = token
        tween(btn, { BackgroundColor3 = accent, TextColor3 = onAccent }, 0.08)
        fn()
        task.spawn(function()
            task.wait(0.4)
            while token == my do
                fn()
                task.wait(0.07)
            end
        end)
    end)

    table.insert(conns, UserInputService.InputEnded:Connect(function(i)
        if not active or not isSamePointer(active, i, true) then return end
        active = nil
        token = token + 1
        tween(btn, { BackgroundColor3 = CARD2, TextColor3 = TEXT }, 0.15)
    end))
end

-- slider generico
local function makeSlider(par, pos, size, vmin, vmax, onChange)
    local hit = new("TextButton", {
        Size = size,
        Position = pos,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, par)

    local track = new("Frame", {
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0.5, -2),
        BackgroundColor3 = CARD2,
        BorderSizePixel = 0,
    }, hit)
    corner(track, 2)

    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 2)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
    }, track)
    corner(knob, 7)

    onTheme(function()
        fill.BackgroundColor3 = accent
        knob.BackgroundColor3 = accent
    end)

    local function slide(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local r = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        onChange(vmin + r * (vmax - vmin))
    end

    local active = nil

    hit.InputBegan:Connect(function(i)
        if not isPress(i) then return end
        active = i
        slide(i.Position.X)
    end)

    table.insert(conns, UserInputService.InputChanged:Connect(function(i)
        if active and isSamePointer(active, i, false) then
            slide(i.Position.X)
        end
    end))

    table.insert(conns, UserInputService.InputEnded:Connect(function(i)
        if active and isSamePointer(active, i, true) then
            active = nil
        end
    end))

    local api = {}
    function api.setValue(v)
        local r = math.clamp((v - vmin) / (vmax - vmin), 0, 1)
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
    end
    return api
end

