local open = true
local transitionToken = 0

local function setOpen(v)
    if open == v then return end
    open = v
    transitionToken = transitionToken + 1
    local my = transitionToken
    if v then
        root.Visible = true
        rootScale.Scale = 0.9
        tween(rootScale, { Scale = 1 }, 0.18)
    else
        tween(rootScale, { Scale = 0.9 }, 0.12)
        task.delay(0.12, function()
            if transitionToken == my and not open then root.Visible = false end
        end)
    end
end

