local function diagnose()
    local lines = {}
    local function add(t) table.insert(lines, t) end

    add("Binarium " .. VERSION .. " diagnostico")
    add("TPS (TCs): " .. tostring(workspace:FindFirstChild("TPS") ~= nil))

    local pitch = workspace:FindFirstChild("Pitch")
    local balls = pitch and pitch:FindFirstChild("Balls")
    add("workspace.Pitch: " .. tostring(pitch ~= nil))
    add("workspace.Pitch.Balls: " .. tostring(balls ~= nil))
    if balls then
        for _, c in ipairs(balls:GetChildren()) do
            add("  Balls." .. c.Name .. " [" .. c.ClassName .. "]")
        end
    end

    lastScan = 0
    local list, gameName = getBalls()
    add("jogo: " .. tostring(gameName) .. " | bolas encontradas: " .. #list)
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    for _, ball in ipairs(list) do
        local line = "  " .. ball:GetFullName() .. " [" .. ball.ClassName .. "] CanTouch=" .. tostring(ball.CanTouch)
        if hrp then
            line = line .. string.format(" dist=%.1f", (hrp.Position - ball.Position).Magnitude)
        end
        add(line)
    end
    add(string.format("reach atual: %.1f", curReach()))
    add("partes no personagem: " .. tostring(lp.Character and #lp.Character:GetChildren() or 0))
    add("firetouchinterest: " .. tostring(hasTouch))

    local text = table.concat(lines, "\n")
    print(text)
    local copied = false
    if setclipboard then copied = pcall(setclipboard, text) end
    toast(copied and "Diagnostico copiado" or "Diagnostico no console (F9)")
end

