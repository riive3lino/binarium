local visualPart = new("Part", {
    Name = "BinariumVisual",
    Shape = Enum.PartType.Ball,
    Anchored = true,
    CanCollide = false,
    CanTouch = false,
    CanQuery = false,
    Material = Enum.Material.Neon,
    Color = accent,
    Transparency = 1,
    Size = Vector3.new(1, 1, 1),
})
visualPart.Parent = workspace
onTheme(function() visualPart.Color = accent end)

local lastLabel = 0
local lastTouch = 0

local hb = RunService.Heartbeat:Connect(function()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local balls, gameName = getBalls()

    if tick() - lastLabel > 0.25 then
        lastLabel = tick()
        if not hasTouch then
            setStatus("Executor sem firetouchinterest", RED, false)
        elseif gameName then
            setStatus(gameName .. " detectado", GREEN, true)
        else
            setStatus("Aguardando bola", DIM, false)
        end
        infoGame.Text = gameName or "nenhum"
        infoGame.TextColor3 = gameName and GREEN or MUTED
    end

    if cfg.visual and hrp then
        local s = curReach() * 2
        visualPart.Size = Vector3.new(s, s, s)
        visualPart.Position = hrp.Position
        visualPart.Transparency = cfg.visualAlpha
    else
        visualPart.Transparency = 1
    end

    if not hasTouch or not char or #balls == 0 then return end
    if tick() - lastTouch < 0.03 then return end

    local reach = curReach()
    for _, ball in ipairs(balls) do
        if ball.Parent then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") and (ball.Position - part.Position).Magnitude <= reach then
                    lastTouch = tick()
                    firetouchinterest(ball, part, 0)
                    firetouchinterest(ball, part, 1)
                end
            end
        end
    end
end)

