local function makeToggle(par, text, y, initial, enabled, callback)
    local row = new("TextButton", {
        Size = UDim2.new(1, -20, 0, 36),
        Position = UDim2.fromOffset(10, y),
        BackgroundColor3 = CARD,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, par)
    corner(row, 10)
    cardStroke(row)

    new("TextLabel", {
        Size = UDim2.new(1, -64, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = enabled and TEXT or DIM,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local track = new("Frame", {
        Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = CARD2,
        BorderSizePixel = 0,
    }, row)
    corner(track, 10)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = MUTED,
        BorderSizePixel = 0,
    }, track)
    corner(knob, 8)

    local state = initial
    local function paint(animate)
        local props1 = { BackgroundColor3 = state and accent or CARD2 }
        local props2 = {
            Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2),
            BackgroundColor3 = state and onAccent or MUTED,
        }
        if animate then
            tween(track, props1)
            tween(knob, props2)
        else
            for k, v in pairs(props1) do track[k] = v end
            for k, v in pairs(props2) do knob[k] = v end
        end
    end
    onTheme(function() paint(false) end)

    row.Activated:Connect(function()
        if not enabled then
            toast("Indisponivel neste executor")
            return
        end
        state = not state
        paint(true)
        callback(state)
    end)
end

