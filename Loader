local function readPos(t)
    if type(t) == "table" and #t == 4 then
        for i = 1, 4 do
            if type(t[i]) ~= "number" then return nil end
        end
        return t
    end
    return nil
end

pcall(function()
    if isfile and isfile(FILE) then
        local d = HttpService:JSONDecode(readfile(FILE))
        if type(d.reaches) == "table" then
            for _, n in ipairs(PROFILES) do
                if type(d.reaches[n]) == "number" then
                    cfg.reaches[n] = math.clamp(math.floor(d.reaches[n] * 10 + 0.5) / 10, 0.5, 100)
                end
            end
        end
        if table.find(PROFILES, d.profile) then cfg.profile = d.profile end
        if type(d.visual) == "boolean" then cfg.visual = d.visual end
        if type(d.visualAlpha) == "number" then cfg.visualAlpha = math.clamp(d.visualAlpha, 0.5, 0.95) end
        if type(d.theme) == "number" then cfg.theme = math.clamp(math.floor(d.theme), 1, 4) end
        if type(d.key) == "string" and pcall(function() return Enum.KeyCode[d.key] end) then
            cfg.key = d.key
        end
        if type(d.showOrb) == "boolean" then cfg.showOrb = d.showOrb end
        cfg.panelPos = readPos(d.panelPos)
        cfg.orbPos = readPos(d.orbPos)
    end
end)

