    local function stopControl()
        control.active = false

        if control.inputConn then
            control.inputConn:Disconnect()
            control.inputConn = nil
        end

        if control.renderConn then
            control.renderConn:Disconnect()
            control.renderConn = nil
        end

        local camera = Workspace.CurrentCamera

        if camera and control.savedType then
            camera.CameraType = control.savedType
            camera.CameraSubject = control.savedSubject
        end

        control.ball = nil

        if control.button then
            control.button.Text = "Controlar bola"
            control.button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        end
    end

    local function startControl()
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local ball = root and GetClosestBall(root)

        if not ball or (ball.Position - root.Position).Magnitude > 80 then
            Notify("Controlar bola", "Nenhuma bola por perto.", "info")
            return
        end

        local camera = Workspace.CurrentCamera
        if not camera then return end

        control.ball = ball
        control.active = true
        control.savedType = camera.CameraType
        control.savedSubject = camera.CameraSubject

        local look = camera.CFrame.LookVector
        control.yaw = math.atan2(-look.X, -look.Z)
        control.pitch = math.asin(math.clamp(look.Y, -1, 1))

        camera.CameraType = Enum.CameraType.Scriptable

        if control.button then
            control.button.Text = "Ativo"
            control.button.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
        end

        control.inputConn = UserInputService.InputChanged:Connect(function(input, processed)
            if not control.active or processed then return end

            if input.UserInputType == Enum.UserInputType.MouseMovement then
                control.yaw = control.yaw - input.Delta.X * 0.004
                control.pitch = math.clamp(control.pitch - input.Delta.Y * 0.004, -1.2, 1.2)
            elseif input.UserInputType == Enum.UserInputType.Touch then
                control.yaw = control.yaw - input.Delta.X * 0.006
                control.pitch = math.clamp(control.pitch - input.Delta.Y * 0.006, -1.2, 1.2)
            end
        end)

        control.renderConn = RunService.RenderStepped:Connect(function()
            local target = control.ball

            if not control.active or not target or not target.Parent then
                stopControl()
                return
            end

            local direction = CFrame.fromEulerAnglesYXZ(control.pitch, control.yaw, 0).LookVector

            pcall(function()
                target.AssemblyLinearVelocity = direction * 70
                target.AssemblyAngularVelocity = Vector3.zero
            end)

            local currentCamera = Workspace.CurrentCamera

            if currentCamera then
                local cameraPosition = target.Position - direction * 16 + Vector3.new(0, 6, 0)
                currentCamera.CFrame = CFrame.lookAt(cameraPosition, target.Position + Vector3.new(0, 1.5, 0))
            end
        end)
    end

    local function destroyBallControl()
        stopControl()

        for _, connection in ipairs(ballConnections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(ballConnections)

        if ballGui then
