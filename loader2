        button = nil,
    }

    local function isPress(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end

    local function isMove(input)
        return input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
    end

    local function makeDraggable(button, list)
        local state = { moved = false }
        local dragging = false
        local dragInput = nil
        local dragStart = nil
        local startPos = nil

        table.insert(list, button.InputBegan:Connect(function(input)
            if isPress(input) then
                dragging = true
                state.moved = false
                dragStart = input.Position
                startPos = button.Position

                local changed
                changed = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        changed:Disconnect()
                    end
                end)
            end
        end))

        table.insert(list, button.InputChanged:Connect(function(input)
            if isMove(input) then
                dragInput = input
            end
        end))

        table.insert(list, UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local delta = input.Position - dragStart

                if delta.Magnitude > 8 then
                    state.moved = true
                end

                button.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end))

        return state
    end

    local function roundButton(parent, text, size, position)
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(0, size, 0, size)
        button.Position = position
        button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        button.BackgroundTransparency = 0.3
        button.Text = text
        button.TextColor3 = Color3.fromRGB(255, 255, 255)  -- TEXTO BRANCO
        button.TextScaled = true
        button.Font = Enum.Font.GothamBold
        button.AutoButtonColor = false
        button.Parent = parent

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = button

        return button
    end

    local function destroyMobileControls()
