local BlockedKeys = {
    W = true, A = true, S = true, D = true, Space = true,
    Q = true, E = true, T = true, F = true, Z = true, C = true, H = true,
    RightShift = true, Unknown = true
}

local HotkeyUI = {}
local HotkeyTitles = {}
local Listening = nil

local function SetHotkey(flag, keyName)
    Hotkeys[flag] = keyName

    local ui = HotkeyUI[flag]

    if ui then
        local text = (keyName == "Nenhuma")
            and "Nenhuma tecla. Clique para escolher."
            or ("Tecla: " .. keyName .. ". Clique para trocar.")

        pcall(function()
            ui:SetDesc(text)
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if Listening then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        local flag = Listening
        local name = input.KeyCode.Name
        Listening = nil

        if name == "Escape" then
            SetHotkey(flag, Hotkeys[flag])
            Notify("ATALHOS", "Cancelado.", "info")
            return
        end

        if name == "Backspace" then
            SetHotkey(flag, "Nenhuma")
            Notify("ATALHOS", HotkeyTitles[flag] .. ": atalho removido.", "check")
            return
        end

        if BlockedKeys[name] then
            SetHotkey(flag, Hotkeys[flag])
            Notify("ATALHOS", "A tecla " .. name .. " não pode ser usada.", "info")
            return
        end

        for otherFlag, bound in pairs(Hotkeys) do
            if otherFlag ~= flag and bound == name then
                SetHotkey(otherFlag, "Nenhuma")
            end
        end

        SetHotkey(flag, name)
        Notify("ATALHOS", HotkeyTitles[flag] .. ": " .. name, "check")
        return
    end

    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    local keyName = input.KeyCode.Name

    for flag, bound in pairs(Hotkeys) do
        if bound ~= "Nenhuma" and bound == keyName then
            local entry = Registry[flag]
            local text = Features[flag]

            if entry then
                local newValue = not entry.Get()
                entry.Set(newValue)

                if text then
                    Notify(text[1], newValue and text[2] or text[3], text[4])
                end
            end
        end
    end
end)

