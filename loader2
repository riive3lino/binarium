local function ShowPage(pageName)
    for name, page in pairs(Pages) do
        page.Visible = name == pageName
    end

    local tabNames = {
        ["Auto Follow"] = "Follow",
        ["Reach"] = "Reach",
        ["Bola"] = "Bola",
        ["Gramado"] = "Gramado",
        ["Anti-Lag"] = "Anti-Lag"
    }

    for name, data in pairs(Tabs) do
        local selected = name == tabNames[pageName]

        data.Button.BackgroundColor3 = selected and CARD or PANEL
        data.Button.TextColor3 = selected and WHITE or MUTED
        data.Stroke.Enabled = selected
        data.Stroke.Color = WHITE
    end
end

