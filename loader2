-- Copiar avatar
do
    local avatarState = { enabled = false, saved = nil }

    local function captureAvatar()
        local character = LocalPlayer.Character
        if not character then return end

        local saved = {
            accessories = {},
            clothing = {},
            characterMeshes = {},
            bodyColors = nil,
            face = nil,
            headMesh = nil,
            partColors = {},
        }

        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Accessory") then
                table.insert(saved.accessories, child:Clone())
            elseif child:IsA("Clothing") or child:IsA("ShirtGraphic") then
                table.insert(saved.clothing, child:Clone())
            elseif child:IsA("BodyColors") then
                saved.bodyColors = child:Clone()
            elseif child:IsA("CharacterMesh") then
                table.insert(saved.characterMeshes, child:Clone())
            elseif child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
                saved.partColors[child.Name] = child.Color
            end
        end

        local head = character:FindFirstChild("Head")

        if head then
            local face = head:FindFirstChildOfClass("Decal")
            if face then
                saved.face = face:Clone()
            end

            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            if mesh then
                saved.headMesh = mesh:Clone()
            end
        end

        avatarState.saved = saved
    end

    local function clearAvatar()
        local character = LocalPlayer.Character
        if not character then return end

        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Accessory") or child:IsA("Clothing") or child:IsA("ShirtGraphic")
                or child:IsA("BodyColors") or child:IsA("CharacterMesh") then
                child:Destroy()
            end
        end

        local head = character:FindFirstChild("Head")

        if head then
            local face = head:FindFirstChildOfClass("Decal")
            if face then
                face:Destroy()
            end

            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            if mesh then
                mesh:Destroy()
            end
        end
    end

    local function attachAccessory(character, accessory)
        local handle = accessory:FindFirstChild("Handle")

        if handle then
            local handleAttachment = handle:FindFirstChildOfClass("Attachment")

            if handleAttachment then
                local target = character:FindFirstChild(handleAttachment.Name, true)

                if target then
                    handle.CFrame = target.WorldCFrame

                    local weld = Instance.new("Weld")
                    weld.Name = "AccessoryWeld"
                    weld.Part0 = handle
                    weld.Part1 = target.Parent
                    weld.C0 = handleAttachment.CFrame
                    weld.C1 = target.CFrame
                    weld.Parent = handle
                end
            end
        end

        accessory.Parent = character
    end

    local function restoreAvatar()
        local character = LocalPlayer.Character
        local saved = avatarState.saved

        if not character or not saved then return end

        clearAvatar()

        for _, accessory in ipairs(saved.accessories) do
            attachAccessory(character, accessory:Clone())
        end

        for _, item in ipairs(saved.clothing) do
            item:Clone().Parent = character
        end

        if saved.bodyColors then
            saved.bodyColors:Clone().Parent = character
        end

        for _, mesh in ipairs(saved.characterMeshes) do
            mesh:Clone().Parent = character
        end

        local head = character:FindFirstChild("Head")

        if head then
            if saved.face then
                saved.face:Clone().Parent = head
            end

            if saved.headMesh then
                saved.headMesh:Clone().Parent = head
            end
        end

        for partName, color in pairs(saved.partColors) do
            local part = character:FindFirstChild(partName)

            if part and part:IsA("BasePart") then
                part.Color = color
            end
        end
    end

    local function applyFromUser(input)
        local character = LocalPlayer.Character
        if not character then
            return false, "Sem personagem."
        end

        local userId = tonumber(input)

        if not userId then
            local okId, foundId = pcall(function()
                return Players:GetUserIdFromNameAsync(input)
            end)

            if not okId then
                return false, "Nome inválido."
            end

            userId = foundId
        end

        local okDescription, description = pcall(function()
            return Players:GetHumanoidDescriptionFromUserId(userId)
        end)

        if not okDescription then
            return false, "Não foi possível ler o avatar."
        end

        local okModel, model = pcall(function()
            return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R6)
        end)

        if not okModel then
            return false, "Não foi possível criar o modelo."
        end

        clearAvatar()

        for _, part in ipairs(model:GetChildren()) do
            local mine = character:FindFirstChild(part.Name)

            if mine and part:IsA("BasePart") and mine:IsA("BasePart") and mine.Name ~= "HumanoidRootPart" then
                mine.Color = part.Color
            end
        end

        local sourceHead = model:FindFirstChild("Head")
        local myHead = character:FindFirstChild("Head")

        if sourceHead and myHead then
            local face = sourceHead:FindFirstChildOfClass("Decal")

            if face then
                face:Clone().Parent = myHead
            else
                local defaultFace = Instance.new("Decal")
                defaultFace.Name = "face"
                defaultFace.Texture = "rbxasset://textures/face.png"
                defaultFace.Parent = myHead
            end

            local mesh = sourceHead:FindFirstChildOfClass("SpecialMesh")

            if mesh then
                mesh:Clone().Parent = myHead
            end
        end

        for _, child in ipairs(model:GetChildren()) do
            if child:IsA("Clothing") or child:IsA("ShirtGraphic")
                or child:IsA("BodyColors") or child:IsA("CharacterMesh") then
                child:Clone().Parent = character
            elseif child:IsA("Accessory") then
                attachAccessory(character, child:Clone())
            end
        end

        model:Destroy()

        return true, "Avatar copiado."
    end

    function Game.setAvatarCopy(enabled, name)
        if enabled then
            if not name or name == "" then
                return false, "Digite um nome ou ID primeiro."
            end

            captureAvatar()

            local ok, message = applyFromUser(name)

            if ok then
                avatarState.enabled = true
            end

            return ok, message
        end

        if avatarState.enabled then
            restoreAvatar()
            avatarState.enabled = false
        end

        return true, "Avatar restaurado."
    end
end

-- Cor do campo
do
    local field = {
        color = Color3.fromRGB(0, 0, 0),
        enabled = false,
        originals = {},
    }

    local surfaceWords = { "grass", "ground", "floor", "terrain", "rock", "baseplate", "tile", "wall", "brick" }

    local function isFieldSurface(part)
        local lowered = part.Name:lower()
        local model = part:FindFirstAncestorOfClass("Model")

        if model then
            local modelName = model.Name:lower()

            if modelName:find("character", 1, true) or modelName:find("player", 1, true) then
                return false
            end
        end

        local parent = part.Parent

        if parent and (parent:IsA("Accessory") or parent:IsA("Tool")) then
            return false
        end

        for _, word in ipairs(surfaceWords) do
            if lowered:find(word, 1, true) then
                return true
            end
        end

        return false
    end

    local function paintField()
        for part in pairs(field.originals) do
            if part.Parent then
                pcall(function()
                    part.Color = field.color
                end)
            end
        end
    end

    local function restoreField()
        for part, color in pairs(field.originals) do
            if part.Parent then
                pcall(function()
                    part.Color = color
                end)
            end
        end

        field.originals = {}
    end

    function Game.setFieldColor(color)
        field.color = color

        if field.enabled then
            paintField()
        end
    end

    function Game.setFieldColorEnabled(enabled)
        if enabled then
            restoreField()

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and isFieldSurface(obj) then
                    field.originals[obj] = obj.Color
                end
            end

            field.enabled = true
            paintField()
        else
            field.enabled = false
            restoreField()
        end
    end
end

