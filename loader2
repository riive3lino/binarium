local Registry = {}
local Features = {}
local Hotkeys = {}

local function AddToggle(tab, flag, opts)
    local state = opts.Default and true or false
    local silent = false
    local element

    Features[flag] = opts.Notify or { opts.Title, "Ativado.", "Desativado.", "info" }

    element = tab:Toggle({
        Title = opts.Title,
        Desc = opts.Desc,
        Value = state,

        Callback = function(value)
            if silent then return end

            state = value and true or false
            opts.OnChange(state)

            if opts.Notify then
                Notify(opts.Notify[1], state and opts.Notify[2] or opts.Notify[3], opts.Notify[4])
            end
        end
    })

    Registry[flag] = {
        Get = function()
            return state
        end,

        Set = function(value)
            state = value and true or false
            opts.OnChange(state)

            silent = true
            pcall(function()
                element:Set(state)
            end)
            silent = false
        end
    }

    return element
end

local function AddSlider(tab, flag, opts)
    local current = opts.Default
    local silent = false
    local element

    element = tab:Slider({
        Title = opts.Title,
        Desc = opts.Desc,
        Step = opts.Step or 1,
        Value = {
            Min = opts.Min,
            Max = opts.Max,
            Default = opts.Default
        },

        Callback = function(value)
            if silent then return end

            current = value
            opts.OnChange(value)
        end
    })

    Registry[flag] = {
        Get = function()
            return current
        end,

        Set = function(value)
            value = tonumber(value)
            if not value then return end

            value = math.clamp(value, opts.Min, opts.Max)
            current = value
            opts.OnChange(value)

            silent = true
            pcall(function()
                element:Set(value)
            end)
            silent = false
        end
    }

    return element
end

local function AddDropdown(tab, flag, opts)
    local current = opts.Default
    local silent = false
    local element

    element = tab:Dropdown({
        Title = opts.Title,
        Desc = opts.Desc,
        Values = opts.Values,
        Value = current,

        Callback = function(value)
            if silent then return end

            current = value
            opts.OnChange(value)
        end
    })

    Registry[flag] = {
        Get = function()
            return current
        end,

        Set = function(value)
            if not table.find(opts.Values, value) then return end

            current = value
            opts.OnChange(value)

            silent = true
            pcall(function()
                element:Select(value)
            end)
            silent = false
        end
    }

    return element
end

