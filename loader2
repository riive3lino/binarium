local currentBallSkin = nil
local originalBalls   = {}

local function applySkinToBall(part, skin)
    pcall(function()
        if not originalBalls[part] then
            local data = { Decals = {}, Surfaces = {}, Color = part.Color, Material = part.Material }

            if part:IsA("MeshPart") then
                data.MeshId    = part.MeshId
                data.TextureID = part.TextureID
            else
                local mesh = part:FindFirstChildOfClass("SpecialMesh")
                if mesh then
                    data.Mesh = {
                        MeshId    = mesh.MeshId,
                        TextureId = mesh.TextureId,
                        MeshType  = mesh.MeshType,
                    }
                end
            end

            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then
                    data.Decals[child] = {
                        Texture      = child.Texture,
                        Transparency = child.Transparency,
                    }
                end
            end

            originalBalls[part] = data
        end

        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("SurfaceAppearance") then
                table.insert(originalBalls[part].Surfaces, child)
                child.Parent = nil
            end
        end

        if skin.Color then
            part.Color = skin.Color
            part.Material = skin.Material or Enum.Material.SmoothPlastic

            if part:IsA("MeshPart") then
                part.TextureID = ""
            else
                local flatMesh = part:FindFirstChildOfClass("SpecialMesh")
                if flatMesh then
                    flatMesh.TextureId = ""
                end
            end

            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then
                    child.Transparency = 1
                end
            end

            return
        end

        part.Color = Color3.fromRGB(0, 0, 0)
        part.Material = originalBalls[part].Material

        if part:IsA("MeshPart") then
            if skin.Mesh then
                part.MeshId = skin.Mesh
            end
            part.TextureID = skin.Texture
        else
            local mesh = part:FindFirstChildOfClass("SpecialMesh")
            if not mesh and skin.Mesh then
                mesh = Instance.new("SpecialMesh")
                mesh.Name = "BinariumSkinMesh"
                mesh.Parent = part
                originalBalls[part].CreatedMesh = true
            end
            if mesh then
                if skin.Mesh then
                    mesh.MeshType = Enum.MeshType.FileMesh
                    mesh.MeshId   = skin.Mesh
                end
                mesh.TextureId = skin.Texture
            end
        end

        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") then
                child.Texture = skin.Texture
                child.Transparency = 0
            end
        end
    end)
end

local function restoreBall(part)
    local data = originalBalls[part]
    if not data then return end

    pcall(function()
        if data.Color then
            part.Color = data.Color
            part.Material = data.Material
        end

        for _, surface in ipairs(data.Surfaces or {}) do
            surface.Parent = part
        end

        if part:IsA("MeshPart") then
            if data.MeshId then part.MeshId = data.MeshId end
            if data.TextureID then part.TextureID = data.TextureID end
        else
            local mesh = part:FindFirstChildOfClass("SpecialMesh")
            if mesh then
                if data.CreatedMesh then
                    mesh:Destroy()
                elseif data.Mesh then
                    mesh.MeshType  = data.Mesh.MeshType
                    mesh.MeshId    = data.Mesh.MeshId
                    mesh.TextureId = data.Mesh.TextureId
                end
            end
        end

        for decal, props in pairs(data.Decals) do
            if decal.Parent then
                decal.Texture = props.Texture
                decal.Transparency = props.Transparency
            end
        end
    end)

    originalBalls[part] = nil
end

function Game.applyBallSkin(name)
    if name == "Original" then
        currentBallSkin = nil
        for part in pairs(originalBalls) do
            restoreBall(part)
        end
        return
    end

    local skin = ballSkins[name]
    if not skin then return end

    currentBallSkin = skin
    for part in pairs(BallCandidates) do
        if part.Parent then
            applySkinToBall(part, skin)
        end
    end
end

