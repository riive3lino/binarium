HotkeysTab:Paragraph({
    Title = "Atalhos de teclado",
    Desc = "Clique no botão da função e aperte a tecla que você quer. Ela fica salva (use Salvar config) e liga/desliga a função. Esc cancela e Backspace remove o atalho.",
    Icon = "keyboard",
    IconThemed = true
})

local HotkeyFeatures = {
    { "reach", "Reach" },
    { "reachSphere", "Reach Sphere" },
    { "follow", "Auto Follow" },
    { "catch", "Auto Catch" },
    { "predict", "Previsão da bola" },
    { "dive", "Auto Dive" },
    { "shield", "Shield da bola" },
    { "hambolo", "Auto Hambolo" }
}

for _, feature in ipairs(HotkeyFeatures) do
    local flag = feature[1]
    local title = feature[2]

    Hotkeys[flag] = "Nenhuma"
    HotkeyTitles[flag] = title

    HotkeyUI[flag] = HotkeysTab:Button({
        Title = title,
        Desc = "Nenhuma tecla. Clique para escolher.",
        Icon = "keyboard",

        Callback = function()
            if Listening == flag then
                Listening = nil
                SetHotkey(flag, Hotkeys[flag])
                return
            end

            if Listening then
                SetHotkey(Listening, Hotkeys[Listening])
            end

            Listening = flag

            pcall(function()
                HotkeyUI[flag]:SetDesc("Aperte uma tecla... (Esc cancela, Backspace remove)")
            end)

            Notify("ATALHOS", "Aperte a tecla para " .. title .. ".", "keyboard")
        end
    })

    Registry["key_" .. flag] = {
        Get = function()
            return Hotkeys[flag]
        end,

        Set = function(value)
            if type(value) ~= "string" then return end

            if value == "Nenhuma" then
                SetHotkey(flag, "Nenhuma")
                return
            end

            local valid = pcall(function()
                return Enum.KeyCode[value]
            end)

            if valid and not BlockedKeys[value] then
                SetHotkey(flag, value)
            end
        end
    }
end

