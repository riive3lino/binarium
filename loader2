                end)
            end))
        end

        local jumpButton = roundButton(gui, "^", 70, UDim2.new(1, -100, 1, -95))

        table.insert(connections, jumpButton.InputBegan:Connect(function(input)
            if isPress(input) then
                jumpHeld = true
                jumpButton.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
            end
        end))

        table.insert(connections, jumpButton.InputEnded:Connect(function(input)
            if isPress(input) then
                jumpHeld = false
                jumpButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            end
        end))

        local radius = 45

        local base = Instance.new("Frame")
        base.Size = UDim2.new(0, 220, 0, 220)
        base.Position = UDim2.new(0, 20, 1, -240)
        base.BackgroundTransparency = 1
        base.Active = true
        base.Parent = gui

        local thumb = Instance.new("Frame")
        thumb.Size = UDim2.new(0, 34, 0, 34)
        thumb.AnchorPoint = Vector2.new(0.5, 0.5)
        thumb.Position = UDim2.new(0.5, 0, 0.5, 0)
        thumb.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        thumb.BackgroundTransparency = 0.35
        thumb.Parent = base

        local thumbCorner = Instance.new("UICorner")
        thumbCorner.CornerRadius = UDim.new(1, 0)
        thumbCorner.Parent = thumb

        local joyActive = false
        local joyInput = nil

        table.insert(connections, base.InputBegan:Connect(function(input, processed)
            if processed then return end

            if isPress(input) then
                joyActive = true
                joyInput = input
            end
        end))

        table.insert(connections, UserInputService.InputChanged:Connect(function(input)
            if not joyActive then return end

            local sameInput = input == joyInput
                or (input.UserInputType == Enum.UserInputType.MouseMovement
                    and joyInput and joyInput.UserInputType == Enum.UserInputType.MouseButton1)

            if not sameInput then return end

            local center = base.AbsolutePosition + base.AbsoluteSize / 2
            local offset = Vector2.new(input.Position.X, input.Position.Y) - center

            if offset.Magnitude > radius then
                offset = offset.Unit * radius
            end

            thumb.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y)
            joystick = offset / radius
        end))

        table.insert(connections, UserInputService.InputEnded:Connect(function(input)
            if joyActive and input == joyInput then
                joyActive = false
                joyInput = nil
                thumb.Position = UDim2.new(0.5, 0, 0.5, 0)
                joystick = Vector2.zero
            end
        end))

        table.insert(connections, RunService.RenderStepped:Connect(function()
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if not humanoid then return end

            if jumpHeld then
                humanoid.Jump = true
            end

            if joystick.Magnitude > 0.05 then
                local camera = Workspace.CurrentCamera
                if not camera then return end

                local look = camera.CFrame.LookVector
                local right = camera.CFrame.RightVector

                local forward = Vector3.new(look.X, 0, look.Z)
                if forward.Magnitude > 0 then
                    forward = forward.Unit
                end

                local side = Vector3.new(right.X, 0, right.Z)
                if side.Magnitude > 0 then
                    side = side.Unit
                end

                humanoid:Move(side * joystick.X + forward * -joystick.Y, false)
            end
        end))
    end

    function Game.setMobileControls(enabled)
