local ConfigFolder = "BinariumHub"
local ConfigDir = ConfigFolder .. "/configs"
local AutoloadFile = ConfigFolder .. "/autoload.txt"

local function CanSave()
    return writefile and readfile and isfile and makefolder and isfolder
end

local function EnsureFolders()
    if not isfolder(ConfigFolder) then
        makefolder(ConfigFolder)
    end

    if not isfolder(ConfigDir) then
        makefolder(ConfigDir)
    end
end

local function CleanName(name)
    local cleaned = tostring(name or ""):gsub("[^%w_%-]", "")

    if cleaned == "" then
        cleaned = "padrao"
    end

    return cleaned
end

local function SaveConfig(name)
    if not CanSave() then
        return false, "Seu executor não suporta salvar arquivos."
    end

    name = CleanName(name)

    local data = {}

    for flag, entry in pairs(Registry) do
        data[flag] = entry.Get()
    end

    local ok, err = pcall(function()
        EnsureFolders()
        writefile(ConfigDir .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    end)

    if ok then
        return true, "Config salva: " .. name
    end

    return false, "Erro ao salvar: " .. tostring(err)
end

local function LoadConfig(name)
    if not CanSave() then
        return false, "Seu executor não suporta ler arquivos."
    end

    name = CleanName(name)

    local path = ConfigDir .. "/" .. name .. ".json"

    if not isfile(path) then
        return false, "Config não encontrada: " .. name
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)

    if not ok or type(data) ~= "table" then
        return false, "Arquivo de config inválido."
    end

    ConfigLoading = true

    for flag, value in pairs(data) do
        local entry = Registry[flag]

        if entry then
            pcall(entry.Set, value)
        end
    end

    ConfigLoading = false

    return true, "Config carregada: " .. name
end

local function DeleteConfig(name)
    if not (CanSave() and delfile) then
        return false, "Seu executor não suporta apagar arquivos."
    end

    name = CleanName(name)

    local path = ConfigDir .. "/" .. name .. ".json"

    if not isfile(path) then
        return false, "Config não encontrada: " .. name
    end

    pcall(delfile, path)

    return true, "Config apagada: " .. name
end

local function ListConfigs()
    local names = {}

    if listfiles and isfolder and isfolder(ConfigDir) then
        local ok, files = pcall(listfiles, ConfigDir)

        if ok then
            for _, file in ipairs(files) do
                local name = tostring(file):match("([^/\\]+)%.json$")

                if name then
                    table.insert(names, name)
                end
            end
        end
    end

    return names
end

local function AutoloadName()
    if CanSave() and isfile(AutoloadFile) then
        local ok, name = pcall(readfile, AutoloadFile)

        if ok and name and name ~= "" then
            return CleanName(name)
        end
    end

    return nil
end

