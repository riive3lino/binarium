        rainConnection = nil
    end
    if rainFolder then
        rainFolder:Destroy()
        rainFolder = nil
    end
    if rainSound then
        rainSound:Destroy()
        rainSound = nil
    end
end

local function startRain()
    stopRain()

    rainFolder = Instance.new("Folder")
    rainFolder.Name = "BinariumRain"
    rainFolder.Parent = Workspace

    local half   = 100
    local height = 50
    local fall   = 120
    local drops  = {}

    for i = 1, 50 do
        local part = Instance.new("Part")
        part.Size         = Vector3.new(0.05, 3, 0.05)
        part.Anchored     = true
        part.CanCollide   = false
        part.CanQuery     = false
        part.CanTouch     = false
        part.CastShadow   = false
        part.Material     = Enum.Material.SmoothPlastic
        part.Color        = Color3.fromRGB(0, 0, 0)
        part.Transparency = 0.5
        part.Parent       = rainFolder

        drops[i] = {
            part = part,
            x = math.random(-half, half),
            y = math.random(0, height),
            z = math.random(-half, half),
        }
    end

    rainConnection = RunService.RenderStepped:Connect(function(dt)
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local center = root and root.Position or Vector3.zero

        for _, drop in ipairs(drops) do
            drop.y = drop.y - fall * dt
            if drop.y < center.Y - 10 then
                drop.y = center.Y + height
                drop.x = math.random(-half, half)
                drop.z = math.random(-half, half)
            end
            drop.part.Position = Vector3.new(center.X + drop.x, drop.y, center.Z + drop.z)
        end
    end)

    rainSound = Instance.new("Sound")
    rainSound.Name    = "BinariumRainAmbience"
    rainSound.SoundId = "rbxassetid://365362615"
    rainSound.Looped  = true
    rainSound.Volume  = 0.4
    rainSound.Parent  = Workspace
    rainSound:Play()
end

