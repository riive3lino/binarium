local function showError(msg)
	warn("[Binarium] " .. tostring(msg))
	pcall(function()
		local g = Instance.new("ScreenGui")
		g.Name = "BinariumError"
		g.ResetOnSpawn = false
		g.DisplayOrder = 1000000
		g.Parent = (gethui and gethui()) or CoreGui

		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(0.9, 0, 0, 170)
		l.Position = UDim2.new(0.05, 0, 0.05, 0)
		l.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		l.TextColor3 = Color3.fromRGB(255, 255, 255)  -- TEXTO BRANCO
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.TextSize = 12
		l.Font = Enum.Font.Code
		l.Text = "[Binarium] Erro (copiado para a área de transferência):\n" .. tostring(msg)
		l.Parent = g

		if setclipboard then setclipboard(tostring(msg)) end
		task.delay(40, function() g:Destroy() end)
	end)
end

local function runScript()
	task.spawn(function()
		local okRun, runErr = xpcall(runHub, function(e)
			return tostring(e) .. "\n" .. tostring(debug.traceback())
		end)

		if not okRun then
			showError(runErr)
		end
	end)
end

runScript()
