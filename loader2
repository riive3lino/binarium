            gui = nil
        end
    end

    function Loading.Finish()
        if finished then return end
        finished = true

        stage = 1
        status.Text = "Finalizando..."

        task.spawn(function()
            while alive and (displayed < 0.99 or os.clock() - started < minTime) do
                task.wait(0.05)
            end

