-- Auto Catch (goleiro)
local autoCatchEnabled  = false
local autoCatchRange    = 10
local autoCatchCooldown = 1
local lastCatchTick     = 0
local reduceCatchPush   = true

local function counterCatchPush(root, humanoid)
    if not reduceCatchPush then return end
    task.spawn(function()
        local start = tick()
        while tick() - start < 0.12 do
            if not root or not root.Parent then return end
            if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then return end
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(velocity.X * 0.1, velocity.Y, velocity.Z * 0.1)
            task.wait()
        end
    end)
end

local function hasGoalkeeperTool()
    local character = LocalPlayer.Character
    if not character then return false end

    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return false end

    return tool.Name == "GK" or tool.Name == "Gk"
end

task.spawn(function()
    while true do
        task.wait()
        if autoCatchEnabled and hasGoalkeeperTool() then
            if tick() - lastCatchTick >= autoCatchCooldown then
                local character = LocalPlayer.Character
                if character then
                    local root = character:FindFirstChild("HumanoidRootPart")
                    if root then
                        for _, object in ipairs(Workspace:GetDescendants()) do
                            if object.Name == "TPS" and (object:IsA("BasePart") or object:IsA("Model")) then
                                local part = object:IsA("BasePart") and object
                                    or (object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart"))

                                if part and (part.Position - root.Position).Magnitude <= autoCatchRange then
                                    pcall(function()
                                        ReplicatedStorage.CatchBall:FireServer(object)
                                    end)
                                    counterCatchPush(root, character:FindFirstChildOfClass("Humanoid"))
                                    lastCatchTick = tick()
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

