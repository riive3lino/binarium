Settings:Button({
    Title = "Listar configs",
    Desc = "Mostra as configs salvas.",
    Icon = "list",

    Callback = function()
        local names = ListConfigs()
        local text = (#names > 0) and table.concat(names, ", ") or "Nenhuma config salva."

        Notify("CONFIGS SALVAS", text, "list")
    end
})

Settings:Toggle({
    Title = "Carregar automaticamente",
    Desc = "Carrega essa config ao abrir o hub.",
    Value = AutoloadName() ~= nil,

    Callback = function(value)
        if not CanSave() then
            Notify("CONFIGURAÇÕES", "Seu executor não suporta salvar arquivos.", "info")
            return
        end

        pcall(function()
            if value then
                EnsureFolders()
                writefile(AutoloadFile, configName)
            elseif isfile(AutoloadFile) and delfile then
                delfile(AutoloadFile)
            end
        end)
    end
})

