avatarToggle = PlayerTab:Toggle({
    Title = "Copiar avatar",
    Desc = "Liga para copiar, desliga para voltar ao seu avatar.",
    Value = false,

    Callback = function(value)
        if avatarReverting then return end

        local ok, message = Game.setAvatarCopy(value, avatarName)
        Notify("Avatar", message, ok and "check" or "info")

