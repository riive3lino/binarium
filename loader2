-- Auto Dive
local VirtualInputManager = game:GetService("VirtualInputManager")
local Debris = game:GetService("Debris")

local diveKeys = {
    center_high = Enum.KeyCode.T,
    center_low  = Enum.KeyCode.F,
    left_high   = Enum.KeyCode.Q,
    left_low    = Enum.KeyCode.Z,
    right_high  = Enum.KeyCode.E,
    right_low   = Enum.KeyCode.C,
}

local diveConfig = {
    enabled = false,
    range   = 15,
    mode    = "Mergulho próprio",
}
local diving       = false
local lastDiveTick = 0
local diveCooldown = 1
local sideDeadzone   = 1.5
local heightThreshold = 1.5
local nearJumpRange  = 8
local nearJumpHeight = 2
local markerRange      = 6
local frontHeightLimit = 1.5

local function groundY(character, root, humanoid)
    local hipHeight = (humanoid and humanoid.HipHeight) or 2
    return root.Position.Y - hipHeight
end

local function pressDiveKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local diveChecks = { team = false, tool = true, ball = false }
local goalkeeperTeamNames = { "Home GK", "Away GK", "-Home GK", "-Away GK" }

local function passesChecks()
    if diveChecks.team then
        local team = LocalPlayer.Team

        if not team or not table.find(goalkeeperTeamNames, team.Name) then
            return false
        end
    end

    if diveChecks.tool and not hasGoalkeeperTool() then
        return false
    end

    return true
end

local function isBallHeld(ball)
    local character = LocalPlayer.Character
    if not character then return false end

    if ball:IsDescendantOf(character) then
        return true
    end

    for _, child in ipairs(ball:GetChildren()) do
        if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
            local part0, part1 = child.Part0, child.Part1

            if (part0 and part0:IsDescendantOf(character)) or (part1 and part1:IsDescendantOf(character)) then
                return true
            end
        end
    end

    for _, armName in ipairs(reachArmNames) do
        local arm = character:FindFirstChild(armName)

        if arm and arm:IsA("BasePart") and (arm.Position - ball.Position).Magnitude <= 3 then
            return true
        end
    end

    return false
end

RunService.Heartbeat:Connect(function()
    if not diveConfig.enabled then return end
    if diveConfig.mode ~= "Teclas do jogo" then return end
    if not passesChecks() then return end
    if diving then return end
    if tick() - lastDiveTick < diveCooldown then return end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return end

    local ball = GetClosestBall(root)
    if not ball or not ball.Parent then return end

    local offset = ball.Position - root.Position
    local distance = offset.Magnitude
    if distance > diveConfig.range then return end

    local heightValue = ball.Position.Y - groundY(character, root, humanoid)

    if distance <= nearJumpRange and heightValue > nearJumpHeight then
        diving = true
        lastDiveTick = tick()
        pcall(function()
            humanoid.Jump = true
        end)
        task.delay(diveCooldown, function()
            diving = false
        end)
        return
    end

    local camera = Workspace.CurrentCamera
    local cameraCFrame = camera and camera.CFrame or root.CFrame

    local inFront = offset:Dot(cameraCFrame.LookVector) > 0
    if inFront and heightValue <= frontHeightLimit then
        local markerNearby = false
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local otherRoot = player.Character:FindFirstChild("HumanoidRootPart")
                if otherRoot and (otherRoot.Position - ball.Position).Magnitude <= markerRange then
                    markerNearby = true
                    break
                end
            end
        end

        if markerNearby then
            diving = true
            lastDiveTick = tick()
            pressDiveKey(Enum.KeyCode.H)
            task.delay(diveCooldown, function()
                diving = false
            end)
            return
        end
    end

    if ball.AssemblyLinearVelocity.Magnitude < 8 then return end

    local sideValue = offset:Dot(cameraCFrame.RightVector)

    local side = "center"
    if sideValue > sideDeadzone then
        side = "right"
    elseif sideValue < -sideDeadzone then
        side = "left"
    end

    local height = (heightValue > heightThreshold) and "high" or "low"
    local keyCode = diveKeys[side .. "_" .. height]

    diving = true
    lastDiveTick = tick()

    pressDiveKey(keyCode)

    task.delay(diveCooldown, function()
        diving = false
    end)
end)


-- Mergulho próprio
do
    local diveAnimations = {
        rightLow = "rbxassetid://16442628314",
        leftLow  = "rbxassetid://16442673035",
        rightMid = "rbxassetid://100418595302523",
        leftMid  = "rbxassetid://97922133636415",
    }

    local own = {
        busy = false,
        last = 0,
        delay = 1,
        duration = 0.7,
        sideSpeed = 32,
        lowLift = 1.8,
        highLift = 3.5,
        minBallSpeed = 8,
        deadzone = 0.25,
        lowLimit = 5,
        midLimit = 10,
        catchLast = 0,
        catchCooldown = 0.08,
        catchReach = 8,
        predictTime = 0.25,
    }

    local function findBall(root)
        local best = nil
        local bestDistance = diveConfig.range

        for part in pairs(BallCandidates) do
            if part.Parent and not isBallHeld(part) then
                local distance = (part.Position - root.Position).Magnitude

                if distance < bestDistance then
                    bestDistance = distance
                    best = part
                end
            end
        end

        return best
    end

    local function classify(ball, root)
        local velocity = ball.AssemblyLinearVelocity

        if velocity.Magnitude < own.minBallSpeed then
            return nil
        end

        local toRoot = root.Position - ball.Position

        if toRoot.Magnitude <= 0 then
            return nil
        end

        if velocity.Unit:Dot(toRoot.Unit) < 0.35 then
            return nil
        end

        local offset = ball.Position - root.Position
        local sideValue = offset:Dot(root.CFrame.RightVector)
        local frontValue = offset:Dot(root.CFrame.LookVector)
        local heightDiff = ball.Position.Y - root.Position.Y

        local height = "High"

        if heightDiff <= own.lowLimit then
            height = "Low"
        elseif heightDiff <= own.midLimit then
            height = "Mid"
        end

        if math.abs(sideValue) <= own.deadzone and frontValue > 0 then
            return "Front", height
        end

        if sideValue > own.deadzone then
            return "Right", height
        end

        if sideValue < -own.deadzone then
            return "Left", height
        end

        return nil
    end

    local function tryCatch(ball)
        if not ball or not ball.Parent then return end

        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local now = os.clock()
        if now - own.catchLast < own.catchCooldown then return end

        local distance = (ball.Position - root.Position).Magnitude
        local predicted = (ball.Position + ball.AssemblyLinearVelocity * own.predictTime - root.Position).Magnitude

        if distance > own.catchReach and predicted > own.catchReach then return end

        local remote = ReplicatedStorage:FindFirstChild("CatchBall")

        if remote and remote:IsA("RemoteEvent") then
            own.catchLast = now
            remote:FireServer(ball)
        end
    end

    local function playAnimation(humanoid, animationId)
        local animator = humanoid:FindFirstChildOfClass("Animator")

        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = humanoid
        end

        local animation = Instance.new("Animation")
        animation.AnimationId = animationId

        local track = nil

        pcall(function()
            track = animator:LoadAnimation(animation)
        end)

        animation:Destroy()

        if track then
            track:Play()

            task.delay(own.duration, function()
                pcall(function()
                    track:Stop()
                    track:Destroy()
                end)
            end)
        end
    end

    local function performDive(ball, direction, height, humanoid, root)
        own.busy = true
        own.last = os.clock()

        local camera = Workspace.CurrentCamera

        if camera then
            local look = camera.CFrame.LookVector
            root.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
        end

        root.AssemblyAngularVelocity = Vector3.zero

        local velocity = Instance.new("BodyVelocity")
        velocity.Parent = root

        local sideVector = root.CFrame.RightVector * own.sideSpeed

        if direction ~= "Right" then
            sideVector = -sideVector
        end

        local lift = root.CFrame.UpVector * ((height == "Low") and own.lowLift or own.highLift)

        velocity.Velocity = sideVector + lift
        velocity.MaxForce = Vector3.new(math.huge, 9999, math.huge)
        Debris:AddItem(velocity, own.duration)

        local animationKey = ((direction == "Right") and "right" or "left")
            .. ((height == "Low") and "Low" or "Mid")

        playAnimation(humanoid, diveAnimations[animationKey])

        local started = os.clock()

        task.spawn(function()
            while os.clock() - started < own.duration do
                tryCatch(ball)
                RunService.Heartbeat:Wait()
            end
        end)

        task.delay(own.duration, function()
            own.busy = false
        end)
    end

    RunService.Heartbeat:Connect(function()
        if not diveConfig.enabled or diveConfig.mode ~= "Mergulho próprio" then return end
        if own.busy then return end
        if os.clock() - own.last < own.delay then return end
        if not passesChecks() then return end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root or humanoid.Health <= 0 then return end

        local ball = findBall(root)
        if not ball then return end

        local direction, height = classify(ball, root)

        if not direction or direction == "Front" then return end

        performDive(ball, direction, height, humanoid, root)
    end)

    function Game.setDiveDelay(value)
        own.delay = value
        diveCooldown = value
    end
end

