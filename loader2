-- Skyboxes personalizadas
local customSkyFile = "BinariumHub/skyboxes.json"
local customSkies   = {}

local function fileSupport()
    return writefile and readfile and isfile and makefolder and isfolder
end

local function saveCustomSkies()
    if not fileSupport() then return false end
    local ok = pcall(function()
        if not isfolder("BinariumHub") then
            makefolder("BinariumHub")
        end
        writefile(customSkyFile, HttpService:JSONEncode(customSkies))
    end)
    return ok
end

local function loadCustomSkies()
    if not fileSupport() or not isfile(customSkyFile) then return end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(customSkyFile))
    end)
    if not ok or type(data) ~= "table" then return end

    for name, faces in pairs(data) do
        if type(name) == "string" and type(faces) == "table" and #faces == 6 then
            customSkies[name] = faces
        end
    end
end

local function sortedSkyNames()
    local names = {}
    for name in pairs(customSkies) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

local function parseSkyIds(text)
    local ids = {}
    for token in tostring(text or ""):gmatch("%d+") do
        if #token >= 5 then
            table.insert(ids, token)
        end
    end

    if #ids == 1 then
        return { ids[1], ids[1], ids[1], ids[1], ids[1], ids[1] }
    end
    if #ids == 6 then
        return ids
    end
    return nil
end

local function applyCustomSky(faces)
    saveOriginalSky()
    removeCustomSky()
    restoreLighting()

    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Sky") then
            table.insert(savedSkies, child)
            child.Parent = nil
        end
    end

    local sky = Instance.new("Sky")
    sky.Name = "BinariumSky"
    sky.SkyboxBk = "rbxassetid://" .. faces[1]
    sky.SkyboxDn = "rbxassetid://" .. faces[2]
    sky.SkyboxFt = "rbxassetid://" .. faces[3]
    sky.SkyboxLf = "rbxassetid://" .. faces[4]
    sky.SkyboxRt = "rbxassetid://" .. faces[5]
    sky.SkyboxUp = "rbxassetid://" .. faces[6]
    sky.CelestialBodiesShown = false
    sky.Parent = Lighting
    customSky = sky
end

loadCustomSkies()

Game.parseSkyIds = parseSkyIds
Game.applyCustomSky = applyCustomSky
Game.sortedSkyNames = sortedSkyNames

function Game.getCustomSky(name)
