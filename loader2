                local nowHeld = not heldKeys[def.key]
                heldKeys[def.key] = nowHeld or nil

                button.BackgroundColor3 = nowHeld and Color3.fromRGB(8, 8, 8) or Color3.fromRGB(0, 0, 0)

                pcall(function()
