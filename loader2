AddToggle(Settings, "notifications", {
    Title = "Notificações",
    Desc = "Ativa ou desativa notificações da Binarium.",
    Default = true,

    OnChange = function(value)
        Config.Notifications = value
    end
})

Settings:Keybind({
    Title = "Abrir / Fechar Binarium",
    Desc = "Clique para escolher outra tecla.",
    Value = "RightShift",
    CanChange = true,

    Callback = function(value)
        local newKey

        if typeof(value) == "EnumItem" then
            newKey = value
        elseif typeof(value) == "string" then
            newKey = Enum.KeyCode[value]
        end

        if not newKey then return end

        local ok, err = pcall(function()
            Window:SetToggleKey(newKey)
        end)

        if not ok then
            warn("[BINARIUM KEYBIND]", err)
        end
    end
})

