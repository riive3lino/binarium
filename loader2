end

function Game.saveCustomSky(name, faces)
    customSkies[name] = faces
    return saveCustomSkies()
end

function Game.deleteCustomSky(name)
    if not name or not customSkies[name] then return false end
    customSkies[name] = nil
    saveCustomSkies()
    return true
end

